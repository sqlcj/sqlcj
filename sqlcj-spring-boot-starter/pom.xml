<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.sqlcj</groupId>
        <artifactId>sqlcj</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sqlcj-spring-boot-starter</artifactId>

    <name>sqlcj spring boot starter</name>
    <description>Spring Boot starter that auto-configures the sqlcj runtime</description>

    <properties>
        <spotless.java.config>${project.basedir}/../config/eclipse-java-formatter.xml</spotless.java.config>
        <spring-boot.version>4.0.9</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                JUnit's BOM is imported ahead of Spring Boot's so that the
                starter's tests run on the reactor's JUnit rather than the one
                Spring Boot manages.
            -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Testcontainers' BOM is imported ahead of Spring Boot's so that
                the starter's tests run one version of Testcontainers: Spring
                Boot manages its core at 2.0.5, under which the reactor's
                PostgreSQL module would not run.
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Jackson's BOM is imported ahead of Spring Boot's for the same
                reason: Spring Boot manages Jackson at 3.1.7, which would hold
                the CLI's modules below the reactor's YAML module, and the
                tests generate their repositories with the CLI.
            -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Spring Boot's BOM decides the versions the starter compiles and
                tests against. It is imported by this module alone; an
                application's own Spring Boot BOM decides the versions it runs.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.sqlcj</groupId>
            <artifactId>sqlcj-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!--
            The processor only writes the auto-configuration metadata Spring
            Boot reads at startup, so it is not part of the starter's own
            dependencies.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            ApplicationContextRunner's assertable context extends an AssertJ
            interface, which spring-boot-test does not bring.
        -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The command line tool is not part of the starter. The tests that
            verify it against PostgreSQL use it to generate the repositories
            the applications they start register.
        -->
        <dependency>
            <groupId>org.sqlcj</groupId>
            <artifactId>sqlcj-cli</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot's JPA support is not part of the starter. The tests use
            it to start a JPA application beside the JDBC one and prove that an
            entity's write and a generated write share one transaction.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
